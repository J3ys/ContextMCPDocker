# Local mode defaults
PINECONE_MODE=local
PINECONE_API_KEY=pclocal
PINECONE_CONTROLLER_HOST=http://pinecone:5080
PINECONE_API_VERSION=2025-01
PINECONE_INDEX_NAME=contextmcp-docs
PINECONE_NAMESPACE=

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=nomic-embed-text
OLLAMA_DIMENSIONS=768
OPENAI_API_KEY=

# Cloud override example
# PINECONE_MODE=cloud
# PINECONE_API_KEY=pcsk_your_real_key
# PINECONE_CONTROLLER_HOST=
# OPENAI_API_KEY=sk-your-real-key

# Local multi-repo indexing (optional)
#
# Set both to index an arbitrary list of local repositories instead of the
# single source in config.yaml. LOCAL_DOCS_ROOT is a host directory mounted
# read-only into the reindex container; LOCAL_DOCS_REPOS is a comma-separated
# list of repo=language pairs, optionally with a repo-relative subpath after
# the language (`repo=language:sub/path`). Each repo name must be a subdirectory
# of LOCAL_DOCS_ROOT and language is one of: java, typescript, javascript.
# Each repo is indexed as a mixed source set: source code plus text-like
# config/infra files (for example yaml/yml/json/properties/xml/toml/conf/cfg/ini,
# shell scripts, Dockerfiles, and common dot-config files such as .gitignore).
LOCAL_DOCS_ROOT=/path/to/your/projects
LOCAL_DOCS_REPOS=repo-one=language-one,repo-two=language-two:sub/path

# Local Pinecone backup/restore (optional)
BACKUP_ROOT=./backups
BACKUP_BATCH_SIZE=1000
# BACKUP_DIR=./backups/contextmcp-docs-2026-07-31T12-00-00Z
# RESTORE_INDEX_NAME=contextmcp-docs
# RESTORE_CLEAR_FIRST=true
# RESTORE_UPSERT_BATCH_SIZE=50
