@@ -0,0 +1,76 @@
+import * as path from 'path';
+import { fileURLToPath } from 'url';
+import { describe, it, expect } from 'vitest';
+import { getCodeGrammar } from './code-grammars.js';
+
+// Mirrors the resolution logic in code-grammars.ts: grammars live at
+// packages/template/grammars, resolved relative to this test file's own
+// directory (packages/template/src/config), not the process cwd.
+const GRAMMARS_DIR = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', '..', 'grammars');
+
+describe('getCodeGrammar', () => {
+  it('returns the default java grammar set', () => {
+    const grammars = getCodeGrammar('java');
+    expect(grammars).toEqual([
+      {
+        extensions: ['.java'],
+        wasmPath: path.join(GRAMMARS_DIR, 'tree-sitter-java.wasm'),
+        astFlavor: 'java',
+      },
+    ]);
+  });
+
+  it('returns the default typescript grammar set covering ts, tsx, js, jsx', () => {
+    const grammars = getCodeGrammar('typescript');
+    expect(grammars).toEqual([
+      {
+        extensions: ['.ts'],
+        wasmPath: path.join(GRAMMARS_DIR, 'tree-sitter-typescript.wasm'),
+        astFlavor: 'web',
+      },
+      {
+        extensions: ['.tsx'],
+        wasmPath: path.join(GRAMMARS_DIR, 'tree-sitter-tsx.wasm'),
+        astFlavor: 'web',
+      },
+      {
+        extensions: ['.js', '.jsx'],
+        wasmPath: path.join(GRAMMARS_DIR, 'tree-sitter-javascript.wasm'),
+        astFlavor: 'web',
+      },
+    ]);
+  });
+
+  it('returns the default javascript grammar set', () => {
+    const grammars = getCodeGrammar('javascript');
+    expect(grammars).toEqual([
+      {
+        extensions: ['.js', '.jsx'],
+        wasmPath: path.join(GRAMMARS_DIR, 'tree-sitter-javascript.wasm'),
+        astFlavor: 'web',
+      },
+    ]);
+  });
+
+  it('returns undefined for an unconfigured language', () => {
+    expect(getCodeGrammar('ruby')).toBeUndefined();
+  });
+
+  it('returns undefined when language is undefined', () => {
+    expect(getCodeGrammar(undefined)).toBeUndefined();
+  });
+
+  it('honors a config-provided override over the built-in default', () => {
+    const config = {
+      codeGrammars: {
+        java: [
+          { extensions: ['.java', '.jav'], wasmPath: 'custom/java.wasm', astFlavor: 'java' as const },
+        ],
+      },
+    };
+    const grammars = getCodeGrammar('java', config as never);
+    expect(grammars).toEqual([
+      { extensions: ['.java', '.jav'], wasmPath: 'custom/java.wasm', astFlavor: 'java' },
+    ]);
+  });
+});
