new file mode 100644
index 0000000..1738176
--- /dev/null
+++ b/packages/template/src/config/code-grammars.ts
@@ -0,0 +1,88 @@
+/**
+ * Code Grammar Manifest
+ *
+ * Maps a source's `language` hint to the set of tree-sitter grammars needed
+ * to parse it: file extensions, the on-disk wasm path, and which AST
+ * node-type table to use when walking the tree ('java' vs 'web', since
+ * javascript/typescript/tsx all share the same node type names for the
+ * constructs the code chunker extracts).
+ *
+ * Hand-picked, not the full tree-sitter-wasms bundle (which ships ~50MB of
+ * grammars for 30+ languages): only java/typescript/tsx/javascript/python are
+ * vendored into the Docker image. Overridable via config.yaml's optional
+ * `codeGrammars` section so a new language can be added later without a
+ * code change.
+ */
+
+import * as path from 'path';
+import { fileURLToPath } from 'url';
+import type { ContextMCPConfig, CodeGrammarEntry } from './schema.js';
+
+// Resolved relative to this file's own location (`packages/template/src/config/`),
+// not relative to the calling process's cwd. This matters because the reindex
+// process runs with cwd `/app` inside the Docker image (see scripts/reindex.sh),
+// while local vitest runs use cwd `packages/template` — a plain relative string
+// would resolve differently (and incorrectly) in one of those environments.
+// Using __dirname-equivalent resolution makes the path correct everywhere.
+const PACKAGE_DIR = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', '..');
+const GRAMMARS_DIR = path.join(PACKAGE_DIR, 'grammars');
+
+const DEFAULT_CODE_GRAMMARS: Record<string, CodeGrammarEntry[]> = {
+  java: [
+    {
+      extensions: ['.java'],
+      wasmPath: path.join(GRAMMARS_DIR, 'tree-sitter-java.wasm'),
+      astFlavor: 'java',
+    },
+  ],
+  typescript: [
+    {
+      extensions: ['.ts'],
+      wasmPath: path.join(GRAMMARS_DIR, 'tree-sitter-typescript.wasm'),
+      astFlavor: 'web',
+    },
+    {
+      extensions: ['.tsx'],
+      wasmPath: path.join(GRAMMARS_DIR, 'tree-sitter-tsx.wasm'),
+      astFlavor: 'web',
+    },
+    {
+      extensions: ['.js', '.jsx'],
+      wasmPath: path.join(GRAMMARS_DIR, 'tree-sitter-javascript.wasm'),
+      astFlavor: 'web',
+    },
+  ],
+  javascript: [
+    {
+      extensions: ['.js', '.jsx'],
+      wasmPath: path.join(GRAMMARS_DIR, 'tree-sitter-javascript.wasm'),
+      astFlavor: 'web',
+    },
+  ],
+  python: [
+    {
+      extensions: ['.py'],
+      wasmPath: path.join(GRAMMARS_DIR, 'tree-sitter-python.wasm'),
+      astFlavor: 'python',
+    },
+  ],
+};
+
+/**
+ * Resolve the grammar set for a given `language` hint, honoring any
+ * `codeGrammars` override in config.yaml. Returns undefined if the language
+ * has no configured grammar (built-in or override).
+ */
+export function getCodeGrammar(
+  language: string | undefined,
+  config?: Pick<ContextMCPConfig, 'codeGrammars'>
+): CodeGrammarEntry[] | undefined {
+  if (!language) return undefined;
+
+  const overrides = config?.codeGrammars;
+  if (overrides && overrides[language]) {
+    return overrides[language];
+  }
+
+  return DEFAULT_CODE_GRAMMARS[language];
+}
