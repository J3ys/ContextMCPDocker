diff --git a/packages/template/src/parser/chunkers/code-chunker.test.ts b/packages/template/src/parser/chunkers/code-chunker.test.ts
new file mode 100644
index 0000000..e84edda
--- /dev/null
+++ b/packages/template/src/parser/chunkers/code-chunker.test.ts
@@ -0,0 +1,506 @@
+import { describe, it, expect, vi } from 'vitest';
+import * as fs from 'fs';
+import * as path from 'path';
+import * as os from 'os';
+import { parseCodeSource } from './code-chunker.js';
+import { DEFAULT_CHUNK_CONFIG } from '../core/config.js';
+import type { SourceConfig } from '../../config/schema.js';
+
+const JAVA_FIXTURE = `package com.example;
+
+public class Greeter {
+    private final String name;
+
+    public Greeter(String name) {
+        this.name = name;
+    }
+
+    /**
+     * Builds a greeting for the configured name.
+     */
+    public String greet() {
+        return "Hello, " + name + "!";
+    }
+
+    public String getName() {
+        return name;
+    }
+
+    public void setName(String name) {
+        this.name = name;
+    }
+}
+`;
+
+const TS_FIXTURE = `export class Greeter {
+  constructor(private name: string) {}
+
+  /**
+   * Builds a greeting for the configured name.
+   */
+  greet(): string {
+    return \`Hello, \${this.name}!\`;
+  }
+}
+
+export function shout(message: string): string {
+  return message.toUpperCase();
+}
+
+export const whisper = (message: string): string => {
+  return message.toLowerCase();
+};
+`;
+
+const TSX_FIXTURE = `import React from 'react';
+
+export function Greeting({ name }: { name: string }) {
+  return <div>Hello, {name}!</div>;
+}
+`;
+
+const JS_FIXTURE = `function add(a, b) {
+  return a + b;
+}
+
+export const subtract = (a, b) => {
+  return a - b;
+};
+`;
+
+const YAML_FIXTURE = `service:
+  name: category-service
+  url: http://category-service:8080
+
+features:
+  categoryTracing: true
+`;
+
+const JSON_FIXTURE = `{
+  "service": "category-service",
+  "timeoutMs": 2500,
+  "retry": true
+}
+`;
+
+const PROPERTIES_FIXTURE = `service.name=category-service
+service.timeout.ms=2500
+feature.category.tracing=true
+`;
+
+const DOCKERFILE_FIXTURE = `FROM eclipse-temurin:21-jre
+COPY build/libs/app.jar /app/app.jar
+ENTRYPOINT ["java", "-jar", "/app/app.jar"]
+`;
+
+const SHELL_FIXTURE = `#!/bin/sh
+set -eu
+
+curl -fsS http://backend:8080/actuator/health
+`;
+
+function writeFixture(dir: string, file: string, content: string): void {
+  const fullPath = path.join(dir, file);
+  fs.mkdirSync(path.dirname(fullPath), { recursive: true });
+  fs.writeFileSync(fullPath, content, 'utf-8');
+}
+
+function writeFixtureReturningPath(dir: string, file: string, content: string): string {
+  writeFixture(dir, file, content);
+  return path.join(dir, file);
+}
+
+function makeSource(overrides: Partial<SourceConfig> & { language: string }): SourceConfig {
+  return {
+    name: 'fixture',
+    displayName: 'Fixture',
+    type: 'local',
+    branch: 'main',
+    path: '.',
+    parser: 'code',
+    optional: false,
+    skipDirs: [],
+    skipFiles: [],
+    ...overrides,
+  } as SourceConfig;
+}
+
+describe('parseCodeSource', () => {
+  it('extracts method-level chunks with attached Javadoc from a Java file', async () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'code-chunker-java-'));
+    writeFixture(dir, 'Greeter.java', JAVA_FIXTURE);
+
+    const chunks = await parseCodeSource(
+      makeSource({ language: 'java', localPath: dir }),
+      dir,
+      DEFAULT_CHUNK_CONFIG
+    );
+
+    const greet = chunks.find(c => c.heading === 'Greeter.greet');
+    expect(greet).toBeDefined();
+    expect(greet!.content).toContain('Builds a greeting for the configured name.');
+    expect(greet!.content).toContain('return "Hello, " + name + "!";');
+    expect(greet!.metadata.language).toBe('java');
+    expect(greet!.metadata.startLine).toBeGreaterThan(0);
+    expect(greet!.metadata.endLine).toBeGreaterThan(greet!.metadata.startLine!);
+
+    // The constructor is a distinct chunk.
+    expect(chunks.some(c => c.heading === 'Greeter.Greeter')).toBe(true);
+  });
+
+  it('merges small getter/setter methods together up to idealChunkSize', async () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'code-chunker-java-merge-'));
+    writeFixture(dir, 'Greeter.java', JAVA_FIXTURE);
+
+    const chunks = await parseCodeSource(
+      makeSource({ language: 'java', localPath: dir }),
+      dir,
+      DEFAULT_CHUNK_CONFIG
+    );
+
+    // getName/setName are both tiny; they should land in the same merged chunk
+    // rather than each being its own separate chunk.
+    const mergedChunk = chunks.find(
+      c => c.content.includes('getName') && c.content.includes('setName')
+    );
+    expect(mergedChunk).toBeDefined();
+  });
+
+  it('emits one chunk per class when codeGranularity is class', async () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'code-chunker-java-class-'));
+    writeFixture(dir, 'Greeter.java', JAVA_FIXTURE);
+
+    const chunks = await parseCodeSource(
+      makeSource({ language: 'java', localPath: dir, codeGranularity: 'class' }),
+      dir,
+      DEFAULT_CHUNK_CONFIG
+    );
+
+    expect(chunks).toHaveLength(1);
+    expect(chunks[0].heading).toBe('Greeter');
+    expect(chunks[0].content).toContain('public String greet()');
+    expect(chunks[0].content).toContain('public String getName()');
+  });
+
+  it('extracts class methods, top-level functions, and const arrow functions from TypeScript', async () => {
